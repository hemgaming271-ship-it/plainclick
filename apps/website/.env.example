# PlainClick website + licensing backend — example environment. NO REAL SECRETS HERE.
# Copy to .env.local for development. In production set these in the host's secret store.

# --- FREE static mode (default; docs/free-release.md): no server, no database, no email provider ---
# "static" (default) or "server" (our own API: webhooks, recovery, waitlist).
NEXT_PUBLIC_SITE_MODE=static
# Product payment link from the Dodo dashboard (test or live).
NEXT_PUBLIC_DODO_PAYMENT_LINK=
# true ONLY for an Apple-notarized build; otherwise the download page shows the "Open Anyway" steps.
NEXT_PUBLIC_RELEASE_NOTARIZED=false
NEXT_PUBLIC_RELEASES_URL=https://github.com/hemgaming271-ship-it/plainclick/releases

# --- Site state (keep both false until a tested release exists) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_RELEASE_AVAILABLE=false
NEXT_PUBLIC_CHECKOUT_ENABLED=false
# Fill only for a real, signed, notarized release (download page stays in "no download yet" state otherwise).
NEXT_PUBLIC_RELEASE_VERSION=
NEXT_PUBLIC_DOWNLOAD_URL=
NEXT_PUBLIC_RELEASE_SHA256=
NEXT_PUBLIC_RELEASE_MIN_MACOS=macOS 14 Sonoma
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.invalid
# Shown on legal pages. Fill in before launch.
NEXT_PUBLIC_SELLER_NAME=[Seller legal name]

# --- Database (PostgreSQL 15+) ---
DATABASE_URL=postgres://plainclick:plainclick@localhost:5432/plainclick

# --- Payment provider: "dodo", "paddle" or "mock" (mock is refused when NODE_ENV=production) ---
PAYMENT_PROVIDER=mock
# Dodo Payments (docs/setup-and-deployment.md §3). "test" or "live" — test and live have separate keys + secrets.
DODO_ENV=test
DODO_API_KEY=
# Webhook signing secret from Dodo > Developer > Webhooks (starts with whsec_)
DODO_WEBHOOK_SECRET=
# The US$5.99 one-time product (pdt_…)
DODO_PRODUCT_ID=
# Paddle (alternative, unused)
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=
# Expected price, verified on every paid webhook (lowest currency unit, pre-tax subtotal).
EXPECTED_CURRENCY=USD
EXPECTED_SUBTOTAL_MINOR=599
MOCK_WEBHOOK_SECRET=dev-only-mock-secret

# --- Licensing keys (generate with: npm run keys:generate) ---
# Ed25519 private key, PKCS#8 PEM, base64-encoded on one line. The PUBLIC key is embedded in the Mac app.
ENTITLEMENT_PRIVATE_KEY_B64=
# 32+ random bytes, base64. HMAC pepper for licence-key lookup hashes.
LICENCE_KEY_PEPPER_B64=
# 32 random bytes, base64. AES-256-GCM key for encrypting licence keys at rest (needed for recovery + email retries).
DATA_ENCRYPTION_KEY_B64=
# 32+ random bytes, base64. HMAC key for hashing IPs in rate-limit buckets.
RATE_LIMIT_SALT_B64=

# --- Email: "resend" or "console" (console prints to server log; dev only) ---
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="PlainClick <licences@example.invalid>"

# --- Job runner auth (cron calls POST /api/jobs/email with Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET=

# Rate limiting: number of reverse proxies in front of the app that append to X-Forwarded-For (default 1).
# cf-connecting-ip / x-real-ip are used first when your host sets them.
TRUSTED_PROXY_COUNT=1
