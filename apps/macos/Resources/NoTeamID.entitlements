<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Only for ad-hoc / self-signed builds (no Apple Team ID): the hardened runtime otherwise refuses to load the
         embedded Sparkle.framework, because library validation needs a matching Team ID. Notarized builds don't get it. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
